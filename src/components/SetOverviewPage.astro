---
import { getPublicCratesBySet, getRustuseSet } from '../data/crates';
import CrateGrid from './CrateGrid.astro';
import MascotNote from './MascotNote.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  setName: string;
}

const { setName } = Astro.props as Props;
const set = getRustuseSet(setName);

if (!set) {
  throw new Error(`Unknown RustUse set for overview page: ${setName}`);
}

const crates = getPublicCratesBySet(set.name);
const hasCrateCatalog = crates.length > 0;
const hasExpandedCrateCatalog = crates.some((crate) => crate.name !== set.name);
---

<MascotNote title={set.name} description={set.description} />

<p>
  <StatusBadge status={set.status} /> Published set facade in the RustUse navigation
  surface.
</p>

<p>
  <code>{set.name}</code> is included in the published <code>rustuse</code>{' '}
  facade set menu. The shared crate catalog includes the current public crates for
  this workspace, while curated guides and workspace Rustdocs still expand set-by-set.
</p>

<h2>Package links</h2>

<ul class="ru-set-links">
  <li>
    <a href={set.repositoryUrl} target="_blank" rel="noopener noreferrer">
      GitHub
    </a>
  </li>
  {
    set.cratesIoUrl ? (
      <li>
        <a href={set.cratesIoUrl} target="_blank" rel="noopener noreferrer">
          crates.io
        </a>
      </li>
    ) : null
  }
  {
    set.docsRsUrl ? (
      <li>
        <a href={set.docsRsUrl} target="_blank" rel="noopener noreferrer">
          docs.rs fallback
        </a>
      </li>
    ) : null
  }
  {
    set.workspaceApiPath ? (
      <li>
        <a href={set.workspaceApiPath}>Workspace Rustdocs</a>
      </li>
    ) : null
  }
</ul>

<h2>Public crate tracks</h2>

{
  hasCrateCatalog ? (
    <CrateGrid crates={crates} />
  ) : (
    <p>
      The curated crate catalog for this set has not been expanded on
      RustUse.org yet. The set is present in navigation now so the published
      facade map is complete while focused crate pages and workspace Rustdocs
      are added in later waves.
    </p>
  )
}

<h2>Current docs posture</h2>

{
  set.workspaceApiPath ? (
    <p>
      This set already has a generated workspace Rustdocs bundle and stable API
      redirects for its current public crate tracks.
    </p>
  ) : hasExpandedCrateCatalog ? (
    <p>
      This set now has generated crate pages in the shared catalog, while
      curated set guides and workspace Rustdocs are still being added
      incrementally.
    </p>
  ) : (
    <p>
      This set now has its facade crate page in the shared catalog plus external
      package links. Focused crate pages and generated workspace Rustdocs will
      follow as the set expands.
    </p>
  )
}

<style>
  .ru-set-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ru-set-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ru-color-sand) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .ru-set-links a:hover,
  .ru-set-links a:focus-visible {
    color: var(--ru-color-sand);
  }

  :root[data-theme='light'] .ru-set-links a {
    background: rgba(255, 255, 255, 0.9);
    color: var(--sl-color-gray-1);
  }

  :root[data-theme='light'] .ru-set-links a:hover,
  :root[data-theme='light'] .ru-set-links a:focus-visible {
    color: var(--ru-color-clay);
  }
</style>
