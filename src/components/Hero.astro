---
import type { ImageMetadata } from 'astro';

import { LinkButton } from '@astrojs/starlight/components';
import DraftContentNotice from '@astrojs/starlight/components/DraftContentNotice.astro';
import { Image } from 'astro:assets';

import notFound2d from '../assets/404-2D.png';
import notFound3d from '../assets/404-3D.png';
import ferris2d from '../assets/ferris-2D.png';
import ferris3d from '../assets/ferris-3D.png';

const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isLandingPage = pathname === '/';
const isNotFoundHero = Boolean(
  image && 'file' in image && image.file.src === notFound2d.src,
);

const HERO_IMAGE_WIDTH = 400;

const getImageAttrs = (source: ImageMetadata, alt = image?.alt || '') => ({
  loading: 'eager' as const,
  decoding: 'async' as const,
  width: HERO_IMAGE_WIDTH,
  height: Math.round((HERO_IMAGE_WIDTH * source.height) / source.width),
  alt,
});

const mascotModeImage:
  { alt: string; image2d: ImageMetadata; image3d: ImageMetadata } | undefined =
  isLandingPage
    ? {
        alt: image?.alt || 'Ferris the Rust crab',
        image2d: ferris2d,
        image3d: ferris3d,
      }
    : isNotFoundHero
      ? {
          alt:
            image?.alt ||
            'A Rust mascot helping the reader recover from a missing page',
          image2d: notFound2d,
          image3d: notFound3d,
        }
      : undefined;

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
  if ('file' in image) {
    darkImage = image.file;
  } else if ('dark' in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else {
    rawHtml = image.html;
  }
}
---

<div class="hero">
  {
    mascotModeImage ? (
      <>
        <Image
          src={mascotModeImage.image3d}
          {...getImageAttrs(mascotModeImage.image3d, mascotModeImage.alt)}
          class="ru-hero-figure is-3d"
        />
        <Image
          src={mascotModeImage.image2d}
          {...getImageAttrs(mascotModeImage.image2d, mascotModeImage.alt)}
          class="ru-hero-figure is-2d"
        />
      </>
    ) : (
      <>
        {darkImage && (
          <Image
            src={darkImage}
            {...getImageAttrs(darkImage)}
            class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
          />
        )}
        {lightImage && (
          <Image
            src={lightImage}
            {...getImageAttrs(lightImage)}
            class="dark:sl-hidden"
          />
        )}
      </>
    )
  }
  {rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1
        id={PAGE_TITLE_ID}
        class:list={['ru-hero-title', { 'is-landing': isLandingPage }]}
        data-page-title
        set:html={title}
      />
      {data.draft && <DraftContentNotice />}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({
              attrs: { class: className, ...attrs } = {},
              icon,
              link: href,
              text,
              variant,
            }) => (
              <LinkButton
                {href}
                {variant}
                icon={icon?.name}
                class:list={[className]}
                {...attrs}
              >
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }
  </div>
</div>

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      grid-template-columns: 100%;
      align-items: center;
      gap: 1rem;
      padding-bottom: 1rem;
    }

    .hero > img,
    .hero > .hero-html,
    .hero > .ru-hero-media {
      object-fit: contain;
      width: min(70%, 20rem);
      height: auto;
      margin-inline: auto;
    }

    .ru-hero-figure.is-2d {
      display: none;
    }

    :root[data-mascot-mode='2d'] .ru-hero-figure.is-3d {
      display: none;
    }

    :root[data-mascot-mode='2d'] .ru-hero-figure.is-2d {
      display: block;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 50ch;
    }

    .ru-hero-title {
      font-size: clamp(
        var(--sl-text-3xl),
        calc(0.25rem + 5vw),
        var(--sl-text-6xl)
      );
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .tagline {
      font-size: clamp(
        var(--sl-text-base),
        calc(0.0625rem + 2vw),
        var(--sl-text-xl)
      );
      color: var(--sl-color-gray-2);
    }

    .actions {
      gap: 1rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    @media (min-width: 50rem) {
      .hero {
        grid-template-columns: 7fr 4fr;
        gap: 3%;
        padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
      }

      .hero > img,
      .hero > .hero-html,
      .hero > .ru-hero-media {
        order: 2;
        justify-self: end;
        width: min(100%, 25rem);
      }

      .stack {
        text-align: start;
      }

      .copy {
        align-items: flex-start;
      }

      .actions {
        justify-content: flex-start;
      }

      .hero .ru-hero-title {
        font-size: clamp(6rem, 5rem + 3.4vw, 8.75rem);
      }
    }
  }
</style>
