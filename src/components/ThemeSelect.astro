---
const { compact = false } = Astro.props;
---

<starlight-theme-select class:list={{ 'is-compact': compact }}>
  {
    compact ? (
      <button
        class="ru-toolbar-icon-toggle"
        type="button"
        aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
        title="Toggle light and dark"
      >
        <span class="sr-only">
          {Astro.locals.t('themeSelect.accessibleLabel')}
        </span>
        <svg
          aria-hidden="true"
          class="ru-toolbar-mobile-icon is-light"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="--sl-icon-size: 1em;"
        >
          <path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z" />
        </svg>
        <svg
          aria-hidden="true"
          class="ru-toolbar-mobile-icon is-dark"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="--sl-icon-size: 1em;"
        >
          <path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z" />
        </svg>
      </button>
    ) : (
      <>
        <label
          class="ru-toolbar-select"
          style="--sl-select-width: 6.25em"
          title="Toggle light and dark with Shift+T"
        >
          <span class="sr-only">
            {Astro.locals.t('themeSelect.accessibleLabel')}
          </span>
          <svg
            aria-hidden="true"
            class="ru-toolbar-select-icon ru-toolbar-label-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            style="--sl-icon-size: 1em;"
          >
            <path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z" />
          </svg>
          <select
            class="ru-toolbar-select-input"
            autocomplete="off"
            title="Toggle light and dark with Shift+T"
          >
            <option value="dark" selected>
              {Astro.locals.t('themeSelect.dark')}
            </option>
            <option value="light">{Astro.locals.t('themeSelect.light')}</option>
            <option value="auto">{Astro.locals.t('themeSelect.auto')}</option>
          </select>
          <svg
            aria-hidden="true"
            class="ru-toolbar-select-icon ru-toolbar-select-caret"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            style="--sl-icon-size: 1em;"
          >
            <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z" />
          </svg>
        </label>
        <kbd
          class="ru-toolbar-shortcut"
          style="--ru-toolbar-shortcut-width: 2.05rem;"
          aria-hidden="true"
          title="Shortcut: Shift+T"
        >
          ⇧T
        </kbd>
      </>
    )
  }
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  type ThemeProvider = {
    updatePickers: (theme?: Theme) => void;
    setTheme: (theme: Theme) => void;
    toggleTheme: () => void;
  };

  const storageKey = 'starlight-theme';
  const starlightThemeProvider = (
    window as unknown as Window & {
      StarlightThemeProvider: ThemeProvider;
    }
  ).StarlightThemeProvider;

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'dark';

  const loadTheme = (): Theme => {
    const storedTheme =
      typeof localStorage !== 'undefined'
        ? localStorage.getItem(storageKey)
        : null;
    return storedTheme ? parseTheme(storedTheme) : 'dark';
  };

  function onThemeChange(theme: Theme): void {
    starlightThemeProvider.setTheme(theme);
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto');
  });

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());
      this.querySelector('select')?.addEventListener('change', (event) => {
        if (event.currentTarget instanceof HTMLSelectElement) {
          onThemeChange(parseTheme(event.currentTarget.value));
        }
      });
      this.querySelector('button.ru-toolbar-icon-toggle')?.addEventListener(
        'click',
        () => {
          starlightThemeProvider.toggleTheme();
        },
      );
    }
  }

  customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
  @layer starlight.components {
    :global(:root[data-theme='light'])
      starlight-theme-select.is-compact
      .ru-toolbar-mobile-icon.is-light {
      display: block;
    }

    :global(:root:not([data-theme='light']))
      starlight-theme-select.is-compact
      .ru-toolbar-mobile-icon.is-dark {
      display: block;
    }
  }
</style>
