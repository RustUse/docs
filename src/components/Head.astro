---
import { Font } from 'astro:assets';

import logo from '../assets/logo.png';

type HeadEntry = {
  tag: string;
  attrs?: Record<string, string | boolean | undefined>;
  content?: string;
};

const { head } = Astro.locals.starlightRoute;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pathname = Astro.url.pathname;
const canonicalUrl =
  getLinkHref(head, 'canonical') ?? new URL(pathname, siteUrl).toString();
const pageTitle = getMetaContent(head, 'property', 'og:title') ?? 'RustUse';
const pageDescription =
  getMetaContent(head, 'name', 'description') ??
  getMetaContent(head, 'property', 'og:description') ??
  'RustUse provides composable facades of primitive Rust utility crates.';
const socialImageUrl = new URL(logo.src, siteUrl).toString();
const socialImageAlt = 'RustUse logo mark on a soft neutral background';
const isHomePage = pathname === '/';
const isNotFoundPage = pathname === '/404' || pathname === '/404/';
const isDocsArticle =
  !isHomePage && !isNotFoundPage && !pathname.startsWith('/api/');

const renderedHead = mergeHead(
  head.map((entry) => {
    if (
      entry.tag === 'meta' &&
      entry.attrs?.property === 'og:type' &&
      isHomePage
    ) {
      return { ...entry, attrs: { ...entry.attrs, content: 'website' } };
    }

    return entry;
  }),
  [
    {
      tag: 'link',
      attrs: { rel: 'icon', href: '/favicon.ico', type: 'image/x-icon' },
    },
    { tag: 'link', attrs: { rel: 'manifest', href: '/site.webmanifest' } },
    { tag: 'link', attrs: { rel: 'apple-touch-icon', href: logo.src } },
    { tag: 'meta', attrs: { name: 'theme-color', content: '#ff5a1f' } },
    { tag: 'meta', attrs: { property: 'og:image', content: socialImageUrl } },
    {
      tag: 'meta',
      attrs: { property: 'og:image:alt', content: socialImageAlt },
    },
    {
      tag: 'meta',
      attrs: { property: 'og:image:width', content: String(logo.width) },
    },
    {
      tag: 'meta',
      attrs: { property: 'og:image:height', content: String(logo.height) },
    },
    {
      tag: 'meta',
      attrs: { property: 'og:image:type', content: `image/${logo.format}` },
    },
    { tag: 'meta', attrs: { name: 'twitter:title', content: pageTitle } },
    {
      tag: 'meta',
      attrs: { name: 'twitter:description', content: pageDescription },
    },
    { tag: 'meta', attrs: { name: 'twitter:image', content: socialImageUrl } },
    {
      tag: 'meta',
      attrs: { name: 'twitter:image:alt', content: socialImageAlt },
    },
    ...(isNotFoundPage
      ? [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, follow' } }]
      : []),
  ],
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RustUse',
    url: new URL('/', siteUrl).toString(),
    description:
      'RustUse provides composable facades of primitive Rust utility crates.',
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'RustUse',
    url: new URL('/', siteUrl).toString(),
    logo: socialImageUrl,
    description:
      'RustUse provides composable facades of primitive Rust utility crates.',
    sameAs: ['https://github.com/RustUse'],
  },
  ...(isDocsArticle
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'TechArticle',
          headline: pageTitle,
          description: pageDescription,
          url: canonicalUrl,
          mainEntityOfPage: canonicalUrl,
          isPartOf: {
            '@type': 'WebSite',
            name: 'RustUse',
            url: new URL('/', siteUrl).toString(),
          },
          author: {
            '@type': 'Organization',
            name: 'RustUse',
            url: new URL('/', siteUrl).toString(),
          },
          publisher: {
            '@type': 'Organization',
            name: 'RustUse',
            url: new URL('/', siteUrl).toString(),
            logo: {
              '@type': 'ImageObject',
              url: socialImageUrl,
            },
          },
        },
      ]
    : []),
];

function getMetaContent(
  entries: HeadEntry[],
  attrName: string,
  attrValue: string,
) {
  return entries.find(
    (entry) => entry.tag === 'meta' && entry.attrs?.[attrName] === attrValue,
  )?.attrs?.content;
}

function getLinkHref(entries: HeadEntry[], rel: string) {
  return entries.find(
    (entry) => entry.tag === 'link' && entry.attrs?.rel === rel,
  )?.attrs?.href;
}

function hasHeadEntry(entries: HeadEntry[], entry: HeadEntry) {
  if (entry.tag === 'title') {
    return entries.some((candidate) => candidate.tag === 'title');
  }

  if (entry.tag === 'meta') {
    for (const attr of ['name', 'property', 'http-equiv']) {
      const value = entry.attrs?.[attr];
      if (
        value &&
        entries.some(
          (candidate) =>
            candidate.tag === 'meta' && candidate.attrs?.[attr] === value,
        )
      ) {
        return true;
      }
    }
  }

  if (entry.tag === 'link') {
    const rel = entry.attrs?.rel;
    if (
      rel &&
      entries.some(
        (candidate) => candidate.tag === 'link' && candidate.attrs?.rel === rel,
      )
    ) {
      return true;
    }
  }

  return false;
}

function mergeHead(entries: HeadEntry[], additions: HeadEntry[]) {
  const merged = [...entries];

  for (const entry of additions) {
    if (!hasHeadEntry(merged, entry)) {
      merged.push(entry);
    }
  }

  return merged;
}
---

<Font cssVariable="--font-alfa-slab-one" />
<Font cssVariable="--font-fira-sans" />
{
  renderedHead.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
{
  structuredData.map((schema) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema)}
    />
  ))
}
