---
import { getPublicCratesByFacade, getRustuseFacade } from '../data/crates';
import CrateGrid from './CrateGrid.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  facadeName: string;
}

const { facadeName } = Astro.props as Props;

if (typeof facadeName !== 'string' || facadeName.trim() === '') {
  throw new Error(
    `FacadeOverviewPage requires a non-empty facadeName prop; received ${String(
      facadeName,
    )}.`,
  );
}

const facade = getRustuseFacade(facadeName);

if (!facade) {
  throw new Error(
    `Unknown RustUse facade for overview page: ${facadeName}. Check the MDX callsite uses <FacadeOverviewPage facadeName="..." /> and the value exists in src/data/catalog.generated.js.`,
  );
}

const crates = getPublicCratesByFacade(facade.name);
const facadeCrates = crates.filter((crate) => crate.name !== facade.name);
const facadeCrateCount = facadeCrates.length;
const hasCrateCatalog = facadeCrates.length > 0;
---

<p>
  <StatusBadge status={facade.status} />
</p>

<p>
  {facade.description}
</p>

<h2>Facade links</h2>

<ul class="ru-facade-links">
  {
    facade.workspaceApiPath ? (
      <li>
        <a href={facade.workspaceApiPath} target="_blank" rel="noopener noreferrer">
          RustUse Rustdocs
        </a>
      </li>
    ) : null
  }
  {
    facade.repositoryUrl ? (
      <li>
        <a href={facade.repositoryUrl} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
    ) : null
  }
  {
    facade.cratesIoUrl ? (
      <li>
        <a href={facade.cratesIoUrl} target="_blank" rel="noopener noreferrer">
          crates.io
        </a>
      </li>
    ) : null
  }
  {
    facade.docsRsUrl ? (
      <li>
        <a href={facade.docsRsUrl} target="_blank" rel="noopener noreferrer">
          docs.rs
        </a>
      </li>
    ) : null
  }
</ul>

<h2>Crates in this facade ({facadeCrateCount})</h2>

{
  hasCrateCatalog ? (
    <CrateGrid crates={facadeCrates} />
  ) : (
    <p>
      This RustUse facade does not have any crates.
    </p>
  )
}

<style>
  .ru-facade-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    padding-top: 0.75rem;
  }

  .ru-facade-links li {
    margin: 0;
  }

  .ru-facade-links a {
    display: inline-flex;
    align-items: stretch;
    padding: 0.35rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ru-color-sand) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .ru-facade-links a:hover,
  .ru-facade-links a:focus-visible {
    color: var(--ru-color-sand);
  }

  :root[data-theme='light'] .ru-facade-links a {
    background: rgba(255, 255, 255, 0.9);
    color: var(--sl-color-gray-1);
  }

  :root[data-theme='light'] .ru-facade-links a:hover,
  :root[data-theme='light'] .ru-facade-links a:focus-visible {
    color: var(--ru-color-clay);
  }
</style>
