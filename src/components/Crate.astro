---
import { getCrate } from '../data/catalog';
import Badge from './Badge.astro';
import CrateSourcePanel from './CrateSourcePanel.astro';
import DocsLinks from './DocsLinks.astro';
import StatusNote from './StatusNote.astro';

interface Props {
  name: string;
}

const { name } = Astro.props as Props;
const crate = getCrate(name);

if (!crate) {
  throw new Error(`Unknown crate for overview page: ${name}`);
}

const isFacade = crate.name === crate.facade;
const hasApiDocs = Boolean(crate.docsUrl);
const hasSourceBundle = Boolean(crate.apiPath);
const usesWorkspaceApiRoute =
  crate.docsUrl?.startsWith(`/api/workspaces/${crate.facade}/`) ?? false;
const roleTitle = isFacade ? 'Facade crate' : 'Focused crate';
const roleDescription = isFacade
  ? `${crate.name} is the facade entry point for the ${crate.facade} facade. ${crate.description}`
  : `${crate.name} is a focused crate in the ${crate.facade} facade. ${crate.description}`;
const rustdocsSummary = !hasApiDocs
  ? "RustUse-hosted RustDocs are not generated for this crate yet. Use the facade page plus registry links while this facade's generated docs surface is still being expanded."
  : usesWorkspaceApiRoute
    ? 'This crate currently uses a workspace-scoped RustUse RustDocs route because a stable published crate route is not available.'
    : 'This crate uses a stable RustUse RustDocs route alongside the workspace Rustdocs bundle.';
const sourcePanelDescription = usesWorkspaceApiRoute
  ? `Copy the current ${crate.name} source bundle or inspect the workspace-scoped files that back this crate's RustUse docs surface.`
  : `Copy the current ${crate.name} source bundle or inspect the files behind the stable RustUse docs surface for this crate.`;
---

<StatusNote title={roleTitle} description={roleDescription} />

<p>
  <Badge value={crate.version} /> Versioned crate with live registry and docs.rs links.
</p>

<p>
  <code>{crate.name}</code> belongs to the <a href={crate.facadePath}
    >{crate.facade}</a
  >{' '}
  facade.
</p>

<h2>Package links</h2>

<DocsLinks crate={crate} />

<h2>Facade placement</h2>

{
  isFacade ? (
    <p>
      Use <code>{crate.name}</code> when you want the facade crate instead of
      depending on focused crates one by one. The facade remains the curated
      entry point for the current <code>{crate.facade}</code> surface.
    </p>
  ) : (
    <p>
      Use <code>{crate.name}</code> directly when you want a narrower dependency
      surface than the <code>{crate.facade}</code> facade. It remains part of
      the current crate inventory for this facade.
    </p>
  )
}

<h2>RustDocs</h2>

<p>{rustdocsSummary}</p>

{
  hasSourceBundle ? (
    <CrateSourcePanel
      crateName={crate.name}
      description={sourcePanelDescription}
    />
  ) : (
    <p>
      Copyable source bundles are added when this crate gets a generated RustUse
      RustDocs route on RustUse.org.
    </p>
  )
}

<h2>Tags</h2>

<div class="ru-crate-overview-tags">
  {crate.tags.map((tag) => <Badge value={tag} variant="clay" />)}
</div>

<style>
  .ru-crate-overview-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
