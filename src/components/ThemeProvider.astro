<!-- Default to dark unless the user has explicitly chosen light or auto. -->
<script is:inline>
  window.StarlightThemeProvider = (() => {
    const storageKey = 'starlight-theme';
    const parseTheme = (theme) =>
      theme === 'auto' || theme === 'light' || theme === 'dark'
        ? theme
        : 'dark';
    const resolveTheme = (theme) =>
      theme === 'auto'
        ? window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark'
        : theme === 'light'
          ? 'light'
          : 'dark';
    const storedTheme =
      typeof localStorage !== 'undefined'
        ? localStorage.getItem(storageKey)
        : null;
    const theme = parseTheme(storedTheme || 'dark');
    const resolvedTheme = resolveTheme(theme);
    document.documentElement.dataset.theme = resolvedTheme;
    return {
      updatePickers(theme = storedTheme || 'dark') {
        document
          .querySelectorAll('starlight-theme-select')
          .forEach((picker) => {
            const select = picker.querySelector('select');
            if (select) select.value = theme;
            /** @type {HTMLTemplateElement | null} */
            const tmpl = document.querySelector('#theme-icons');
            const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
            if (newIcon) {
              const oldIcon = picker.querySelector('svg.label-icon');
              if (oldIcon) {
                oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
              }
            }
          });
      },
      setTheme(theme) {
        const nextTheme = parseTheme(theme);
        document.documentElement.dataset.theme = resolveTheme(nextTheme);
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem(storageKey, nextTheme);
        }
        this.updatePickers(nextTheme);
      },
      toggleTheme() {
        const currentTheme =
          document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        this.setTheme(currentTheme === 'light' ? 'dark' : 'light');
      },
    };
  })();

  window.RustUseMascotModeProvider = (() => {
    const storageKey = 'rustuse-mascot-mode';
    const storedMode =
      typeof localStorage !== 'undefined'
        ? localStorage.getItem(storageKey)
        : null;
    const resolveDefaultMode = () =>
      document.documentElement.dataset.theme === 'light' ? '2d' : '3d';
    const parseMode = (mode) => (mode === '2d' || mode === '3d' ? mode : null);
    const initialMode = parseMode(storedMode) || resolveDefaultMode();
    document.documentElement.dataset.mascotMode = initialMode;
    return {
      updatePickers(mode = initialMode) {
        document
          .querySelectorAll('rustuse-mascot-mode-select')
          .forEach((picker) => {
            const select = picker.querySelector('select');
            if (select) select.value = mode;
            /** @type {HTMLTemplateElement | null} */
            const tmpl = document.querySelector('#mascot-mode-icons');
            const newIcon =
              tmpl &&
              tmpl.content.querySelector(`[data-mascot-icon="${mode}"]`);
            if (newIcon) {
              const oldIcon = picker.querySelector('svg.label-icon');
              if (oldIcon) {
                oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
              }
            }
          });
      },
      setMode(mode) {
        document.documentElement.dataset.mascotMode = mode;
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem(storageKey, mode);
        }
        this.updatePickers(mode);
      },
      toggleMode() {
        const currentMode =
          document.documentElement.dataset.mascotMode === '2d' ? '2d' : '3d';
        this.setMode(currentMode === '2d' ? '3d' : '2d');
      },
    };
  })();

  if (!window.RustUseShortcutBindingsInstalled) {
    const isInteractiveTarget = (target) =>
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        Boolean(
          target.closest(
            'input, textarea, select, button, summary, [contenteditable], [role="textbox"]',
          ),
        ));

    window.addEventListener('keydown', (event) => {
      if (
        event.defaultPrevented ||
        event.repeat ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey ||
        !event.shiftKey ||
        isInteractiveTarget(event.target)
      ) {
        return;
      }

      const key = event.key.toLowerCase();
      if (key === 't') {
        event.preventDefault();
        window.StarlightThemeProvider.toggleTheme();
      }

      if (key === 'm') {
        event.preventDefault();
        window.RustUseMascotModeProvider.toggleMode();
      }
    });

    window.RustUseShortcutBindingsInstalled = true;
  }
</script>

