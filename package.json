{
  "name": "rustuse",
  "description": "RustUse documentation site for composable facades of primitive Rust utility crates for fellow crustaceans.",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "a11y": "npm run a11y:axe && npm run a11y:pa11y",
    "a11y:axe": "npm exec -- axe http://localhost:8080 --rules color-contrast",
    "a11y:pa11y": "npm exec -- pa11y http://localhost:8080 --standard WCAG2AA",
    "audit": "npm audit --audit-level=high",
    "dev": "astro dev",
    "dev:fresh": "npm run generate && npm run dev",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "build:rustdocs": "node scripts/build-rustdocs.mjs",
    "build": "npm run generate && astro build",
    "check": "astro check",
    "check:llms": "node scripts/generate-llms-txt.mjs --check",
    "check:llms:ci": "node scripts/generate-llms-txt.mjs --check --allow-missing-workspaces",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate": "npm run generate:catalog && npm run build:rustdocs && npm run generate:llms",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "lint": "eslint . --cache --cache-location ./.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --cache --cache-location ./.cache/eslint/.eslintcache --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "preview": "astro preview",
    "preview:8080": "astro preview --host 127.0.0.1 --port 8080",
    "prepare": "npm run setup:hooks",
    "setup:hooks": "node scripts/setup-githooks.mjs",
    "sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application > sbom.cyclonedx.json",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "validate": "npm run format && npm run lint && npm run lint:css && npm run check",
    "validate:full": "npm run validate && npm run build && npm run smoke:dist",
    "update:check": "ncu --reject typescript",
    "update": "ncu -u --reject typescript && npm install"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "@astrojs/language-server": "^2.16.8",
    "fast-uri": "^3.1.2",
    "yaml": "^2.8.4"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.3",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.3",
    "@fontsource/alfa-slab-one": "^5.2.8",
    "@fontsource/fira-sans": "^5.2.7",
    "astro": "^7.0.7",
    "katex": "^0.17.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/cli": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^17.7.0",
    "npm-check-updates": "^22.2.9",
    "pa11y": "^9.1.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@24.43.1": true,
    "chromedriver@150.0.3": true
  }
}