{
  "name": "rustuse",
  "description": "Public documentation site and generated API reference for RustUse.",
  "type": "module",
  "version": "0.1.1",
  "scripts": {
    "a11y": "npm run a11y:axe && npm run a11y:pa11y",
    "a11y:axe": "npm exec -- axe http://localhost:8080 --rules color-contrast",
    "a11y:pa11y": "npm exec -- pa11y http://localhost:8080 --standard WCAG2AA",
    "audit": "npm audit --audit-level=high",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:fresh": "node scripts/dev.mjs --fresh",
    "dev": "astro dev",
    "start": "npm run dev",
    "build:api": "node scripts/build-rustdocs.mjs",
    "build": "npm run build:api && astro -- build",
    "check": "astro -- check",
    "check:llms": "node scripts/generate-llms-txt.mjs --check",
    "check:llms:ci": "node scripts/generate-llms-txt.mjs --check --allow-missing-workspaces",
    "checkout:llms-workspaces": "node scripts/checkout-llms-workspaces.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "generate:llms": "node scripts/generate-llms-txt.mjs",
    "lint": "eslint . --cache --cache-location ./.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --cache --cache-location ./.cache/eslint/.eslintcache --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "preview": "astro -- preview",
    "preview:8080": "astro -- preview --host 127.0.0.1 --port 8080",
    "prepare": "npm run setup:hooks",
    "setup:hooks": "node scripts/setup-githooks.mjs",
    "sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application > sbom.cyclonedx.json",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "validate": "npm run format && npm run lint && npm run lint:css && npm run check",
    "validate:full": "npm run validate && npm run build && npm run smoke:dist",
    "update": "npx npm-check-updates -u && npm install"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@astrojs/language-server": "^2.16.8",
    "fast-uri": "^3.1.2",
    "yaml": "^2.8.4"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-satteri": "0.2.2",
    "@astrojs/mdx": "6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.40.0",
    "@fontsource/alfa-slab-one": "^5.2.8",
    "@fontsource/fira-sans": "^5.2.7",
    "astro": "^6.4.7",
    "katex": "^0.17.0",
    "satteri": "^0.8.1",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-unicorn": "^67.0.0",
    "globals": "^17.6.0",
    "npm-check-updates": "^22.2.3",
    "pa11y": "^9.1.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
