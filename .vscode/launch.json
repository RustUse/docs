{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run dev",
      "name": "Docs dev server",
      "request": "launch",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "https?://(?:localhost|127\\.0\\.0\\.1):4321/?"
      },
      "type": "node-terminal"
    },
    {
      "command": "npm run preview:8080",
      "name": "Docs preview 8080",
      "request": "launch",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "https?://127\\.0\\.0\\.1:8080/?"
      },
      "type": "node-terminal"
    },
    {
      "command": "npm run dev:doctor",
      "name": "Run dev doctor",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "npm run verify:fast",
      "name": "Run verify fast",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "npm run validate:full",
      "name": "Run validate full",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "npm run dev",
      "name": "Development server (npm)",
      "request": "launch",
      "type": "node-terminal"
    }
  ]
}
